<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="TheVoid.MainWindow"

        Title="The Void" 
        Background="#040404" 
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

        <Window.Styles>
            <Style Selector="TextBox.messageBox">
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Height" Value="100"/>
                <Setter Property="Margin" Value="30"/>
                <Setter Property="Padding" Value="15"/>
                <Setter Property="Background" Value="#111111"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="PlaceholderText" Value="Type Message Here..."/>
                <Setter Property="FontFamily" Value="{StaticResource LowerPixel}"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="LetterSpacing" Value="1"/>
                <Setter Property="Foreground" Value="#EEEEEE"></Setter>
            </Style>

            <Style Selector="TextBox.messageBox:focus /template/ Border#PART_BorderElement">
                <Setter Property="Background" Value="#111111"/>
                <Setter Property="BorderBrush" Value="#111111"/>
                <Setter Property="BorderThickness" Value="0"/>
            </Style>

            <Style Selector="TextBox.messageBox:pointerover /template/ Border#PART_BorderElement">
                <Setter Property="BorderBrush" Value="#111111"/>
                <Setter Property="Background" Value="#111111"/>
            </Style>
            
        </Window.Styles>

        <Grid>
            <Border Background="#111111" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Background="Transparent" PointerPressed="TitleBar_PointerPressed">
    
                    <Button Content="—" Background="Transparent" FontSize="18" Click="MinimizeButton_Clicked"/>
    
                    <Button Content="□" Background="Transparent" FontSize="18" Click="MaximizeButton_Clicked"/>
    
                    <Button Content="✕" Background="Transparent" FontSize="18" Click="CloseButton_Clicked"/>
    
                </StackPanel>
            </Border>

            <StackPanel VerticalAlignment="Bottom">
                <TextBox x:Name="MessageBox" Classes="messageBox" AcceptsReturn="True" KeyDown="MessageBox_KeyDown"/>
            </StackPanel>

        </Grid>

        
</Window>
